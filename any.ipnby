      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 37. Display Fibonacci Sequence Using Recursion"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def fibonacci(n):\n",
        "    return n if n <= 1 else fibonacci(n - 1) + fibonacci(n - 2)\n",
        "\n",
        "for i in range(10):\n",
        "    print(fibonacci(i), end=\" \")\n",
        "print()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 38. Find Sum of Natural Numbers Using Recursion"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def sum_recur(n):\n",
        "    return n + sum_recur(n - 1) if n > 0 else 0\n",
        "\n",
        "print(sum_recur(10))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 39. Find Factorial of Number Using Recursion"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def factorial(n):\n",
        "    return 1 if n <= 1 else n * factorial(n - 1)\n",
        "\n",
        "print(factorial(5))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 40. Convert Decimal to Binary Using Recursion"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def dec_to_bin(n):\n",
        "    if n > 1:\n",
        "        dec_to_bin(n // 2)\n",
        "    print(n % 2, end=\"\")\n",
        "\n",
        "dec_to_bin(10)\n",
        "print()\n"
      ]
    },
    {
