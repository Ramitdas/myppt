      "source": [
        "### 4. Calculate the Area of a Triangle"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "base = 10\n",
        "height = 5\n",
        "area = 0.5 * base * height\n",
        "print(f\"Area: {area}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 5. Solve Quadratic Equation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import cmath\n",
        "\n",
        "a, b, c = 1, 5, 6\n",
        "d = b**2 - 4*a*c\n",
        "root1 = (-b - cmath.sqrt(d)) / (2*a)\n",
        "root2 = (-b + cmath.sqrt(d)) / (2*a)\n",
        "print(f\"Roots: {root1}, {root2}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
