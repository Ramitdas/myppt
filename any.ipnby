      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 15. Check Prime Number"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "num = 29\n",
        "is_prime = num > 1 and all(num % i != 0 for i in range(2, int(num**0.5) + 1))\n",
        "print(f\"Is prime: {is_prime}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 16. Print all Prime Numbers in an Interval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "start, end = 10, 50\n",
        "primes = [n for n in range(start, end + 1) if n > 1 and all(n % i != 0 for i in range(2, int(n**0.5) + 1))]\n",
        "print(f\"Primes between {start} and {end}: {primes}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
