        "### 19. Print the Fibonacci Sequence"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "n = 10\n",
        "a, b = 0, 1\n",
        "for _ in range(n):\n",
        "    print(a, end=\" \")\n",
        "    a, b = b, a + b\n",
        "print()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 20. Check Armstrong Number"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "num = 153\n",
        "order = len(str(num))\n",
        "is_armstrong = num == sum(int(digit) ** order for digit in str(num))\n",
        "print(f\"Is Armstrong: {is_armstrong}\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 21. Find Armstrong Number in an Interval"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "start, end = 100, 1000\n",
        "armstrongs = [n for n in range(start, end) if n == sum(int(d)**len(str(n)) for d in str(n))]\n",
        "print(armstrongs)\n"
      ]
    },
    {
      "cell_type": "markdown",
