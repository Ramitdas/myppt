      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 95. Measure the Elapsed Time in Python"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import time\n",
        "\n",
        "start_time = time.perf_counter()\n",
        "time.sleep(0.05)\n",
        "elapsed = time.perf_counter() - start_time\n",
        "print(f\"Elapsed time: {elapsed:.4f} seconds\")\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 96. Represent enum"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from enum import Enum\n",
        "\n",
        "class Color(Enum):\n",
        "    RED = 1\n",
        "    GREEN = 2\n",
        "    BLUE = 3\n",
        "\n",
        "print(Color.RED)\n",
        "print(Color.RED.name)\n",
        "print(Color.RED.value)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 97. Create a Countdown Timer"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import time\n",
        "\n",
        "seconds = 3\n",
        "while seconds > 0:\n",
        "    print(f\"Time left: {seconds}\")\n",
        "    time.sleep(1)\n",
        "    seconds -= 1\n",
        "print(\"Time's up!\")\n"
      ]
