      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### 80. Find Hash of File"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import hashlib\n",
        "\n",
        "def file_hash(filename):\n",
        "    h = hashlib.sha256()\n",
        "    with open(filename, \"rb\") as f:\n",
        "        while chunk := f.read(8192):\n",
        "            h.update(chunk)\n",
        "    return h.hexdigest()\n",
        "\n",
        "print(\"Function defined.\")\n"
      ]
    },
    {
